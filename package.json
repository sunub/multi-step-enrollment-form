{
  "name": "multi-step-enrollment-form",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:next": "next dev --webpack",
    "dev:mock": "pnpm --filter @shared/mock... run build && pnpm --filter @shared/mock run start",
    "start:mock": "pnpm --filter @shared/mock run start",
    "dev": "concurrently -k -n \"MOCK,NEXT\" -c \"magenta,cyan\" \"pnpm run dev:mock\" \"pnpm run dev:next\"",
    "build:packages": "pnpm run -r build",
    "build": "pnpm run build:packages && next build --webpack",
    "start": "next start",
    "test": "pnpm run build && vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "pnpm run build && playwright test",
    "metrics:report": "node scripts/vault-metrics-report.mjs",
    "format": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write .",
    "check": "pnpm biome check --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@shared/design-system": "workspace:*",
    "@shared/mock": "workspace:*",
    "@shared/types": "workspace:*",
    "@tanstack/react-query": "^5.100.10",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1",
    "jotai": "^2.20.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-icons": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vanilla-extract/esbuild-plugin": "^2.3.1",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
