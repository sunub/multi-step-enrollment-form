{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "dist",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"strict": true,
		"noEmit": false,
		"incremental": false,
		"declaration": true,
		"emitDeclarationOnly": false
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
