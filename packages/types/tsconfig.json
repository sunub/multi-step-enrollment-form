{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"resolveJsonModule": true,
		"lib": ["ES2022", "DOM"]
	},
	"include": ["main.ts"],
	"exclude": ["node_modules", "dist"]
}
